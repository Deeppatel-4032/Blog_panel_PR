<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>forgot password</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  </head>
  <body>
    <div class="container d-flex justify-content-center align-items-center vh-100">
        <div class="card p-4 shadow-lg" style="width: 100%; max-width: 400px;">
          <h4 class="card-title text-center mb-3">Trouble logging in?</h4>
           <span>
               Enter your email we'll send you a link to get back into your account.
           </span>
          <form method="post" action="/forgotPassCon">
            <!-- Email Input -->
            <div class="mb-3 mt-3">
              <input type="email" class="form-control" name="email" id="email" placeholder="Enter your email" required>
            </div>
    
            <!-- Send Login Link Button -->
            <button type="submit" class="btn btn-primary w-100">Send Login Link</button>
          </form>
          
          <!-- Additional Options -->
          <div class="text-center mt-3">
            <a href="/loginForm" class="text-muted">Back to Login</a>
          </div>
        </div>
      </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  </body>
</html>