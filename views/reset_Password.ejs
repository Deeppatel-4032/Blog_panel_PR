<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>reset password</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    
    <style>
        /* Add shadow and padding to the form container */
        .form-container {
            padding: 30px;
            background-color: #fff;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3); /* Box shadow */
        }

        body {
            background-color: #f8f9fa; /* Light background color */
        }

        h3 {
            font-weight: 600;
        }

        /* Optional: Customize the button */
        button.btn-primary {
            background-color: #007bff;
            border: none;
            padding: 10px 20px;
            font-size: 16px;
            border-radius: 5px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: background-color 0.3s ease;
        }

        button.btn-primary:hover {
            background-color: #0056b3;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="row justify-content-center mt-5">
            <div class="col-md-6">
                <div class="form-container"> <!-- Apply shadow to the form container -->
                    <h3 class="text-center mb-4">Reset Password</h3>
                    <form method="post" action="/resetPassword/<%= id %>" class="needs-validation" novalidate>
                        <!-- New password Field -->
                        <div class="mb-3">
                            <label for="newPassword" class="form-label">New password</label>
                            <input type="text" class="form-control" id="newPassword" name="new_Pass"
                                placeholder="Enter new password" required>
                            <div class="invalid-feedback">
                                Please enter a new password.
                            </div>
                        </div>

                        <!-- Confirm New password Field -->
                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label">Confirm New password</label>
                            <input type="text" class="form-control" name="conf_Pass" id="confirmPassword"
                                placeholder="Confirm new password" required>
                            <div class="invalid-feedback">
                                Please confirm your new password.
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-primary w-100">Reset Password</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
</body>

</html>
