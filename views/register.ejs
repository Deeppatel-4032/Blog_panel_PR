<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>register Form</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="css/register.css" />
  </head>
  <style>
    .alert{
      position: absolute;
      top: 30px;
      right: 40%;
      z-index: 10000;
    }
  </style>
  <body>
    <body>
      <% if (registerMag) { %>
        <div class="alert alert-info alert-dismissible me-3 fade show" role="alert" id="registerMag">
          <%= registerMag %>
        </div>
        <% } %>
        <div class="container">
          <div class="d-flex justify-content-center mt-5">
            <div class="register-container p-5">
              <h2>Create an Account</h2>
        
              <!-- Registration Form -->
              <form action="/register" method="POST" class="mt-5" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="imgPath" class="form-label">Image URL :</label>
                    <input type="file" class="form-control" id="imgPath" name="userPath" placeholder="Enter image URL" required>
                </div>
    
                <div class="form-group">
                  <label for="username">Username :</label>
                  <input type="text" id="username" name="userName" required>
                </div>
    
                <div class="form-group">
                  <label for="username">email address :</label>
                  <input type="email" id="username" name="email" required>
                </div>
                
                <div class="form-group">
                  <label for="password">Password :</label>
                  <input type="password" id="password" name="password" required>
                </div>
    
                <div class="form-group">
                  <label for="confirmPassword">Confirm Password :</label>
                  <input type="password" id="confirmPassword" name="comPass" required>
                </div>
    
                <div class="form-group">
                  <label for="confirmPassword">Role :</label>
                  <input type="text" id="confirmPassword" name="role" required>
                </div>
    
                <button type="submit" class="btn">Register</button>
              </form>
          
              <!-- Link to Login Page -->
              <div class="login-link">
                Already have an account? <a href="/logInForm">Log in here</a>
              </div>
            </div>    
          </div>
        </div>

      <!-- bootstrap script -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
      
    <!-- jquery script -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>


    <script>
      // JavaScript to handle the hide/show of navbar on scroll
      const registerMag = document.getElementById('registerMag');
      setTimeout(() => {
        $(registerMag).fadeOut("fast")
      }, 1500);
    </script>
  </body>
</html>